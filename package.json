{
  "name": "go-types",
  "version": "2.0.0",
  "private": true,
  "description": "Type-checking and conversion utilities for JavaScript",
  "license": "MIT",
  "author": "Michael Ko",
  "email": "koyote130708@gmail.com",
  "keywords": [
    "type checking",
    "type-checking",
    "types",
    "primitives",
    "objects",
    "conversion",
    "validation",
    "typescript"
  ],
  "homepage": "https://github.com/koyote130708/go-types",
  "repository": {
    "type": "git",
    "url": "https://github.com/koyote130708/go-types.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=8"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.js",
    "docs": "node scripts/docs.js",
    "pack:package": "node scripts/pack-package.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node scripts/test.js",
    "test:docs": "node scripts/docs.js --check && node --test scripts/test-docs.js",
    "test:types": "node scripts/test-types.js",
    "test:build": "node --test scripts/test-build.js scripts/test-package-workflow.js",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:tree-shaking": "node scripts/test-tree-shaking.js",
    "test:package": "node scripts/test-package.js",
    "test:browser": "node scripts/test-browser.js",
    "coverage": "npm test -- --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100",
    "verify": "npm run lint && npm run format:check && node scripts/verify.js",
    "verify:all": "npm run lint && npm run format:check && node scripts/verify.js --all",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:compare": "node scripts/benchmark-compare.js",
    "benchmark:hot-paths": "node scripts/benchmark-hot-paths.js",
    "benchmark:matcher-scaling": "node scripts/benchmark-matcher-scaling.js",
    "benchmark:native-exceptions": "node scripts/benchmark-native-exceptions.js",
    "benchmark:numeric-paths": "node scripts/benchmark-numeric-paths.js",
    "prepack": "node scripts/reject-root-package.js",
    "prepublishOnly": "node scripts/reject-root-package.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "playwright": "1.57.0",
    "prettier": "3.9.6",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1"
  }
}
